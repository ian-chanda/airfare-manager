# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` — it is git-ignored.

# Supabase project REST endpoint, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=your-supabase-project-url

# Supabase API key (anon/publishable key used by the desktop client)
SUPABASE_KEY=your-supabase-api-key

# Shared password used to unlock the application
APP_PASSWORD=choose-a-password
